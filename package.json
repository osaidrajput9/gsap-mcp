{
  "name": "@osaidrajput9/gsap-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "GSAP MCP server - GSAP animation guidance and code generation backed by the official GreenSock agent skills",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "gsap-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "pretest": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osaidrajput9/gsap-mcp"
  },
  "author": "Vinh Nguyen",
  "contributors": [
    "Osaid Rajput"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "oxc-parser": "^0.150.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
